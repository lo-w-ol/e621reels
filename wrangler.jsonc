{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "e621reels",
  "main": "src/worker.js",
  "compatibility_date": "2026-03-18",
  // Browser modules are imported by src/assets.js as text and served to pages; tests import them as ES modules.
  "rules": [{ "type": "Text", "globs": ["**/client/*.js"], "fallthrough": true }]
}
